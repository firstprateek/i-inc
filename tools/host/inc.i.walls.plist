<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>inc.i.walls</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>/usr/local/lib/i-inc/walls.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>60</integer>
  <!-- The daemon writes its open machines' addresses here (walls.sh); the walls cover a new one at once. -->
  <key>WatchPaths</key>
  <array>
    <string>/var/run/i-inc/open-machines</string>
  </array>
  <key>StandardOutPath</key>
  <string>/var/log/i-inc-walls.log</string>
  <key>StandardErrorPath</key>
  <string>/var/log/i-inc-walls.log</string>
</dict>
</plist>
