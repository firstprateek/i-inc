{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The bundled launcher page only. The daemon's own pages are remote and get the page capability alone.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "allow-default-daemon",
    "allow-daemon-override"
  ]
}
