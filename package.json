{
  "name": "i-inc",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "biome check .",
    "fix": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && pnpm test:host",
    "test:host": "sh tools/host/test-codex-tools.sh && sh tools/host/test-launchd.sh && sh tools/host/test-walls.sh",
    "bench": "pnpm --filter @i-inc/daemon bench",
    "e2e": "node tools/e2e/run-all.mjs",
    "e2e:install": "playwright install chromium"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.6.3",
    "playwright": "1.63.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
